# MOTIF reproducibility settings
#
# Copy this committed example to config.local.env and edit that ignored file:
#   cp reproducibility/config.example.env reproducibility/config.local.env
#
# Precedence is: command-line arguments > exported environment > config.local.env
# > built-in defaults. Values use plain KEY=VALUE syntax; do not use `export`,
# shell substitutions, or spaces around `=`.

# Absolute path outside the Git checkout for data, checkpoints, logs, and results.
MOTIF_REPRO_ROOT=/path/to/large/storage/motif-repro

# local100 (~100 GB), core6 (~363 GB), extended8 (~519 GB), or full (~1.866 TB).
MOTIF_DEFAULT_PROFILE=local100

# Parallelism used when --workers is not supplied.
MOTIF_DOWNLOAD_WORKERS=8
MOTIF_PREPROCESS_WORKERS=4

# Optional byte ceilings. Leave empty to use safe profile-specific defaults.
MOTIF_RAW_BUDGET_BYTES=
MOTIF_STORAGE_RESERVE_BYTES=

# Keep 0 for faithful pinned-commit checks. Set 1 only for a documented deviation.
MOTIF_ALLOW_DIFFERENT_COMMIT=0
