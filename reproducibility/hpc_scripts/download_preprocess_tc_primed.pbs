#!/bin/bash

# ------------------------------------------------------------
# PBS Job options
# ------------------------------------------------------------

#PBS -N motif_dl_preproc
#PBS -q cpu_std
#PBS -l walltime=24:00:00
#PBS -j eo

# Selecting 1 CPU node, with 48 cores per node, and 256 GB of ram per node
#PBS -l select=1:ncpus=48:mem=256gb

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

set -euo pipefail

cd "$PBS_O_WORKDIR"
module load PrgEnv-gnu

# Site-specific installs may also need a uv/Python module here.

script_dir="$PBS_O_WORKDIR/reproducibility/scripts"

profile="${PROFILE:-${MOTIF_DEFAULT_PROFILE:-local100}}"
download_workers="${DOWNLOAD_WORKERS:-${MOTIF_DOWNLOAD_WORKERS:-8}}"
preprocess_workers="${PREPROCESS_WORKERS:-${MOTIF_PREPROCESS_WORKERS:-4}}"
preprocess_stage="${PREPROCESS_STAGE:-all}"
resume_arg=()

if [[ "${PREPROCESS_RESUME:-0}" == "1" ]]; then
    resume_arg+=(--resume)
fi

echo "Repository: $PBS_O_WORKDIR"
echo "Profile: $profile"
echo "Download workers: $download_workers"
echo "Preprocess workers: $preprocess_workers"
echo "Preprocess stage: $preprocess_stage"
echo "Preprocess resume: ${PREPROCESS_RESUME:-0}"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

# ------------------------------------------------------------
# CPU inter node communication variables
# ------------------------------------------------------------

export OMPI_MCA_pml=ucx
export UCX_NET_DEVICES=mlx5_1:1

# ------------------------------------------------------------
# Executable
# ------------------------------------------------------------

bash "$script_dir/03_download_tc_primed_subset.sh" \
    --profile "$profile" \
    --workers "$download_workers" \
    --execute

"$PBS_O_WORKDIR/.venv/bin/python" "$script_dir/04_verify_raw_tc_primed.py" \
    --profile "$profile"

bash "$script_dir/05_preprocess_tc_primed.sh" \
    --profile "$profile" \
    --stage "$preprocess_stage" \
    --workers "$preprocess_workers" \
    "${resume_arg[@]}" \
    --execute

"$PBS_O_WORKDIR/.venv/bin/python" "$script_dir/06_verify_preprocessed.py" \
    --profile "$profile"

echo "Finished UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
