#!/bin/bash

# ------------------------------------------------------------
# PBS Job options
# ------------------------------------------------------------
#
# Submit from the repository root after the SAR download stage has completed:
#   qsub reproducibility/hpc_scripts/preprocess_sar.pbs
#
# Optional overrides:
#   qsub -v MOTIF_PROFILE=full,MOTIF_SAR_PREPROCESS_WORKERS=48 \
#       reproducibility/hpc_scripts/preprocess_sar.pbs
#
# This job is intentionally offline: download CyclObs SAR first on an
# internet-enabled node with:
#   bash reproducibility/scripts/16_prepare_sar_dataset.sh \
#       --profile full --stage download --resume --execute

#PBS -N motif_sar_pre
#PBS -q cpu_std
#PBS -l walltime=24:00:00
#PBS -j eo

# Selecting 1 CPU node, with 48 cores per node, and 256 GB RAM.
#PBS -l select=1:ncpus=48:mem=256gb

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

set -euo pipefail

cd "$PBS_O_WORKDIR"
module load PrgEnv-gnu

source reproducibility/lib/common.sh

if [[ -n "${PBS_NODEFILE:-}" && -f "$PBS_NODEFILE" ]]; then
    pbs_ncpus="$(wc -l < "$PBS_NODEFILE")"
else
    pbs_ncpus="${NCPUS:-48}"
fi

profile="${MOTIF_PROFILE:-full}"
workers="${MOTIF_SAR_PREPROCESS_WORKERS:-$pbs_ncpus}"
job_id="${PBS_JOBID:-manual}"
run_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
driver_log="$MOTIF_REPRO_ROOT/logs/pbs_preprocess_sar_${profile}_${job_id}_${run_stamp}.log"
sar_log="$MOTIF_REPRO_ROOT/logs/preprocess_sar_${profile}_pbs.log"
metadata_path="$MOTIF_RAW_ROOT/sar_cyclobs/sar_acquisitions_metadata.csv"

mkdir -p "$MOTIF_REPRO_ROOT/logs"
exec > >(tee -a "$driver_log") 2>&1

# Keep runtime state away from read-only home directories.
export UV_CACHE_DIR="${UV_CACHE_DIR:-$MOTIF_REPO_ROOT/.uv-cache}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-$MOTIF_REPRO_ROOT/matplotlib}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

# ------------------------------------------------------------
# Executable
# ------------------------------------------------------------

echo "Repository: $PBS_O_WORKDIR"
echo "Profile: $profile"
echo "Workers: $workers"
echo "MOTIF_REPRO_ROOT: $MOTIF_REPRO_ROOT"
echo "Raw SAR root: $MOTIF_RAW_ROOT/sar_cyclobs"
echo "Preprocessed root: $MOTIF_PREPROCESSED_ROOT"
echo "PBS driver log: $driver_log"
echo "SAR phase log: $sar_log"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ ! -s "$metadata_path" ]]; then
    echo "Missing SAR acquisition metadata; run the download stage first." >&2
    echo "Expected metadata: $metadata_path" >&2
    exit 1
fi

{
    echo "SAR prepare started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    bash reproducibility/scripts/16_prepare_sar_dataset.sh \
        --profile "$profile" \
        --stage prepare \
        --workers "$workers" \
        --resume \
        --execute

    echo "SAR split refresh started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    bash reproducibility/scripts/16_prepare_sar_dataset.sh \
        --profile "$profile" \
        --stage split \
        --workers "$workers" \
        --execute

    echo "SAR constants refresh started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    bash reproducibility/scripts/16_prepare_sar_dataset.sh \
        --profile "$profile" \
        --stage constants \
        --workers "$workers" \
        --execute

    echo "SAR preprocessing stages finished UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
} 2>&1 | tee -a "$sar_log"

"$MOTIF_REPO_ROOT/.venv/bin/python" reproducibility/scripts/17_verify_sar_preprocessed.py \
    --root "$MOTIF_REPRO_ROOT"

echo "Finished UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
