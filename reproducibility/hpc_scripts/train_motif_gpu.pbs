#!/bin/bash

# ------------------------------------------------------------
# PBS Job options
# ------------------------------------------------------------
#
# Submit from the repository root:
#   qsub reproducibility/hpc_scripts/train_motif_gpu.pbs
#
# Optional overrides:
#   qsub -v MOTIF_TRAIN_EXPERIMENT=det_PI,MOTIF_TRAIN_DEVICES=4 \
#       reproducibility/hpc_scripts/train_motif_gpu.pbs
#
# This script assumes the GPU node has no internet access. W&B is forced offline
# and all logs, images, checkpoints, and caches are written under MOTIF_REPRO_ROOT.

#PBS -N motif_train
#PBS -q gpu4_std
#PBS -l walltime=6:00:00
#PBS -j eo

# One GPU node with 48 CPU cores, 4 GPUs, and 512 GB RAM.
# Adjust this line if the target queue exposes a different GPU shape.
#PBS -l select=1:ncpus=48:ngpus=4:mem=512gb

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

set -euo pipefail

cd "$PBS_O_WORKDIR"
module load PrgEnv-nvidia
module load cuda

source reproducibility/lib/common.sh

job_id="${PBS_JOBID:-manual}"
run_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
experiment="${MOTIF_TRAIN_EXPERIMENT:-fm_pmw}"
profile="${MOTIF_PROFILE:-$MOTIF_DEFAULT_PROFILE}"
devices="${MOTIF_TRAIN_DEVICES:-4}"
num_nodes="${MOTIF_TRAIN_NUM_NODES:-1}"
batch_size="${MOTIF_TRAIN_BATCH_SIZE:-1}"
workers="${MOTIF_TRAIN_WORKERS:-8}"
max_epochs="${MOTIF_TRAIN_MAX_EPOCHS:-100}"
accumulate="${MOTIF_TRAIN_ACCUMULATE_GRAD_BATCHES:-4}"
seed="${MOTIF_TRAIN_SEED:-42}"
checkpoint_minutes="${MOTIF_CHECKPOINT_TIME_INTERVAL:-30}"
run_name="${MOTIF_TRAIN_RUN_NAME:-${experiment}_${job_id}}"
driver_log="$MOTIF_REPRO_ROOT/logs/pbs_train_${experiment}_${job_id}_${run_stamp}.log"

mkdir -p \
    "$MOTIF_REPRO_ROOT/logs" \
    "$MOTIF_REPRO_ROOT/wandb/cache" \
    "$MOTIF_REPRO_ROOT/wandb/config" \
    "$MOTIF_REPRO_ROOT/matplotlib" \
    "$MOTIF_REPRO_ROOT/checkpoints" \
    "$MOTIF_REPRO_ROOT/validation"

exec > >(tee -a "$driver_log") 2>&1

# Keep all runtime state away from home directories.
export UV_CACHE_DIR="${UV_CACHE_DIR:-$MOTIF_REPO_ROOT/.uv-cache}"
export WANDB_MODE=offline
export WANDB_DIR="${WANDB_DIR:-$MOTIF_REPRO_ROOT/wandb}"
export WANDB_CACHE_DIR="${WANDB_CACHE_DIR:-$MOTIF_REPRO_ROOT/wandb/cache}"
export WANDB_CONFIG_DIR="${WANDB_CONFIG_DIR:-$MOTIF_REPRO_ROOT/wandb/config}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-$MOTIF_REPRO_ROOT/matplotlib}"

# Avoid CPU library thread storms inside dataloader/model worker processes.
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

# GPU communication settings from the site example. Leave overridable because
# interface names can differ between GPU partitions.
export NCCL_IB_HCA="${NCCL_IB_HCA:-${UCX_NET_DEVICES:-}}"
export NVSHMEM_ENABLE_NIC_PE_MAPPING="${NVSHMEM_ENABLE_NIC_PE_MAPPING:-1}"
export NVSHMEM_HCA_LIST="${NVSHMEM_HCA_LIST:-${UCX_NET_DEVICES:-}}"
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-ib0,ib2}"
export NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME="${NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME:-ib0,ib2}"

echo "Repository: $PBS_O_WORKDIR"
echo "Profile: $profile"
echo "Experiment: $experiment"
echo "Run name: $run_name"
echo "Devices x nodes: $devices x $num_nodes"
echo "Per-device batch: $batch_size"
echo "Gradient accumulation: $accumulate"
echo "Data root: $MOTIF_REPRO_ROOT"
echo "W&B mode: offline"
echo "W&B dir: $WANDB_DIR"
echo "Checkpoint root: $MOTIF_REPRO_ROOT/checkpoints"
echo "Validation dir: $MOTIF_REPRO_ROOT/validation"
echo "PBS driver log: $driver_log"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

nvidia-smi || true

bash reproducibility/scripts/11_train.sh \
    --experiment "$experiment" \
    --profile "$profile" \
    --setup local \
    --devices "$devices" \
    --num-nodes "$num_nodes" \
    --batch-size "$batch_size" \
    --workers "$workers" \
    --max-epochs "$max_epochs" \
    --accumulate-grad-batches "$accumulate" \
    --seed "$seed" \
    --checkpoint-minutes "$checkpoint_minutes" \
    --wandb-mode offline \
    --wandb-project "$MOTIF_WANDB_PROJECT" \
    --wandb-entity "$MOTIF_WANDB_ENTITY" \
    --name "$run_name" \
    --execute

echo "Finished UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
